{
  "name": "ksk-portal-gateway-client",
  "version": "1.0.3",
  "description": "Ung dung Day Cong Du Lieu Kham Suc Khoe Quoc Gia Doc Lap - KSK Portal Gateway",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "set NODE_ENV=development && electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"wait-on http://127.0.0.1:5190 && npm run dev:electron\"",
    "build": "vite build",
    "pack": "npm run build && electron-builder --win",
    "preview": "vite preview"
  },
  "build": {
    "appId": "vn.binhan.kskgateway",
    "productName": "BinhAn KSK Portal Gateway",
    "compression": "maximum",
    "electronLanguages": [
      "vi",
      "en-US"
    ],
    "electronDist": ".electron-predist/electron-v44.3.0-win32-x64-clean",
    "directories": {
      "output": "dist-release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BinhAn KSK Portal Gateway",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*"
    ]
  },
  "keywords": [
    "ksk",
    "portal",
    "gateway",
    "usb-token",
    "emrhub"
  ],
  "author": "BinhAn Hospital",
  "license": "ISC",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "axios": "^1.7.7",
    "concurrently": "^9.1.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.1",
    "wait-on": "^8.0.1"
  },
  "dependencies": {}
}
